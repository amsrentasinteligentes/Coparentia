# Plantilla de variables de entorno — copia esto a .env.local y pega los valores reales ahí
# (nunca en este archivo, nunca en el chat). Sacas los valores de Supabase → Settings → API.

# Cliente (se incrustan en el navegador — son públicas por diseño, protegidas por RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor (NUNCA con prefijo NEXT_PUBLIC_, NUNCA en código que corre en el navegador) —
# se salta toda la seguridad de Supabase. Solo la usan app/admin/acciones.ts y
# lib/supabase/admin.ts para crear/borrar cuentas a mano.
SUPABASE_SERVICE_ROLE_KEY=

# Correo que recibe las consultas de Asistencia jurídica (opcional; por defecto el de la abogada en lib/email.ts)
CONSULTAS_JURIDICAS_EMAIL=

# Firma secreta ("hottok") que Hotmart manda en cada aviso de pago — sin ella, el webhook rechaza
# TODO aviso entrante (falla cerrada a propósito). Se consigue en Hotmart → Herramientas → Webhooks.
HOTMART_HOTTOK=

# Clave del correo transaccional (bienvenida, pago fallido, constancias mensuales) — resend.com → API Keys.
RESEND_API_KEY=

# Secreto compartido que protege api/cron/constancias de que cualquiera en internet lo dispare —
# sin él, la ruta responde 503 y no envía nada. Vercel lo manda solo en sus propios crons si se
# configura igual en Project Settings → Environment Variables.
CRON_SECRET=

# Modelo de IA usado para leer comprobantes (lib/ocr-recibo.ts) — nunca hardcodeado en el código.
AI_MODEL=claude-sonnet-5

# Clave de la API de Anthropic — la lee el SDK automáticamente, nunca se expone al navegador.
ANTHROPIC_API_KEY=
